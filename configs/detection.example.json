{
  "experiment_name": "crosslingual_halueval_detection_nllb_smoke_v1",
  "output_dir": "results/detection",
  "seed": 42,
  "num_samples": 20,
  "dataset": {
    "name": "pminervini/HaluEval",
    "subset": "qa",
    "split": "data"
  },
  "models": [
    {
      "name": "qwen2.5-7b",
      "path": "Qwen/Qwen2.5-7B-Instruct"
    }
  ],
  "languages": [
    {
      "code": "en",
      "name": "English",
      "translator": null
    },
    {
      "code": "zh",
      "name": "Chinese",
      "translator": {
        "model": "facebook/nllb-200-distilled-600M",
        "source_lang": "eng_Latn",
        "target_lang": "zho_Hans",
        "dtype": "float16",
        "num_beams": 4
      },
      "translation_max_length": 512,
      "translation_quality": {
        "require_grounded_answer_alignment": true,
        "max_critical_warning_rate": 0.1,
        "max_grounded_alignment_loss_rate": 0.25,
        "fail_on_quality_gate": false
      }
    }
  ],
  "model_loading": {
    "dtype": "bfloat16",
    "device_map": "auto"
  },
  "detection": {
    "max_new_tokens": 4,
    "high_confidence_threshold": 0.75
  }
}
