#!/bin/bash
#PBS -N hallu-negatives
#PBS -P 13014407
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe

# Override the project if needed: qsub -P PROJECT_ID ...
source "${PBS_O_WORKDIR:?}/jobs/nscc_2ap/common.sh"

CMD=(python scripts/build_length_controlled_halueval.py --config "${CONFIG:-configs/controlled_benchmark.full.json}")
[[ -n "${NUM_SAMPLES:-}" ]] && CMD+=(--num-samples "$NUM_SAMPLES")
[[ -n "${EXPERIMENT_NAME:-}" ]] && CMD+=(--experiment-name "$EXPERIMENT_NAME")
"${CMD[@]}"
