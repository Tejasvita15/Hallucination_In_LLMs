#!/bin/bash
#PBS -N hallu-micro
#PBS -P 13014407
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe

source "${PBS_O_WORKDIR:?}/jobs/nscc_2ap/common.sh"
# Run all diagnostics even if one model fails its quality gate.
FAILED=0
for MODEL in qwen llama deepseek; do
  if python scripts/run_halueval_detection.py --config "configs/detection.${MODEL}-review-v2.micro.json"; then
    echo "$MODEL completed"
  else
    echo "$MODEL failed; inspect its saved diagnostics"
    FAILED=1
  fi
done
exit "$FAILED"
