#!/bin/bash
#PBS -N hallulens
#PBS -P 13014407
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe

# Override the project if needed: qsub -P PROJECT_ID ...
source "${PBS_O_WORKDIR:?}/jobs/nscc_2ap/common.sh"

case "${TASK:-}" in
  precisewikiqa) SCRIPT=scripts/task1_precisewikiqa.sh ;;
  longwiki) SCRIPT=scripts/task2_longwiki.sh ;;
  mixedentities) SCRIPT=scripts/task3-1_mixedentities.sh ;;
  generatedentities) SCRIPT=scripts/task3-2_generatedentities.sh ;;
  *) echo "Set TASK to precisewikiqa, longwiki, mixedentities or generatedentities" >&2; exit 2 ;;
esac
cd "${HALLULENS_DIR:-data/benchmarks/raw/HalluLens}"
echo "Using the endpoint configured in this checkout's utils/lm.py"
bash "$SCRIPT"
